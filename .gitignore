# dependencies and build output: reproducible from the tree, and far too big to
# belong in history (dist/ is the packed app, the installers and the block maps)
node_modules/
dist/

# scratch from the diagnostics and the measurement runs
tmp-diag/
*.log

# OS noise
.DS_Store
Thumbs.db

# Python bytecode from the build scripts
__pycache__/
*.pyc

# Android build inputs, staged by scripts/fetch_android_deps.py (never committed)
android/deps/
android/loader/src/main/assets/revenge.js
android/loader/src/main/assets/assault-runtime.js

# Build output the tree regenerates, per kind. `build/` itself stays tracked: the icons and
# build/README.md are electron-builder's *inputs*, and it is only the reports a diagnostics run
# leaves behind that are output.
build/reports/
release/

# Gradle and the Android modules' own output, including the interpreter's cache in .gradle/
.gradle/
android/loader/build/
android/manager/build/
