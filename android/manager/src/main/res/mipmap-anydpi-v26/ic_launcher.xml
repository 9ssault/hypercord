<!-- language: XML, file: android/manager/src/main/res/mipmap-anydpi-v26/ic_launcher.xml

     The launcher icon, in the one density-independent form the module's minSdk (26)
     needs: an adaptive icon, so there is no PNG to keep in five densities and
     nothing to go stale when the mark changes. `anydpi` covers every density and the
     `-v26` qualifier is exactly the Android version that understands it, which is
     also the module's floor - a lower floor would need a legacy bitmap here. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
